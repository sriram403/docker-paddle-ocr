AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=europe-west2
VERTEX_MODEL=gemini-2.5-flash

ENABLE_PUBSUB_LISTENER=false
PUBSUB_SUBSCRIPTION=projects/jlr-dl-iqm/subscriptions/iqm_rms_ai_upload_sub
PUBSUB_TOPIC=projects/jlr-dl-iqm/topics/iqm_rms_ai
PUBSUB_NUM_PAGES=0

API_PORT=8000
DEFAULT_MODEL_TYPE=vl
OCR_LANGUAGE=en
GPU_MEMORY_FRACTION=0.7
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_MODEL_NAME=PaddleOCR-VL-1.5-0.9B
# Absolute host path containing PaddleOCR-VL-1.5. ${HOME} is expanded by Compose.
PADDLEX_MODEL_ROOT=${HOME}/.paddlex/official_models
# Change this to a responsive regional Ubuntu mirror if image builds time out.
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
