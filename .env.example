AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=europe-west2
VERTEX_MODEL=gemini-2.5-flash

ENABLE_PUBSUB_LISTENER=false
PUBSUB_SUBSCRIPTION=projects/jlr-dl-iqm/subscriptions/iqm_rms_ai_upload_sub
PUBSUB_TOPIC=projects/jlr-dl-iqm/topics/iqm_rms_ai
PUBSUB_NUM_PAGES=0

API_PORT=8000
CLIENT_NAME=JLR
DEFAULT_MODEL_TYPE=vl
OCR_LANGUAGE=en
GPU_MEMORY_FRACTION=0.7
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_MODEL_NAME=PaddleOCR-VL-1.5-0.9B
VLLM_LOGGING_LEVEL=INFO
CHECKPOINT_MAX_MB=500
LOG_MAX_MB=200
MAX_DOWNLOAD_MB=100
REQUEST_TIMEOUT_S=60
# Host path containing PaddleOCR-VL-1.5. Keep it relative to this repository
# or replace it with an explicit absolute path; do not use ${HOME} with sudo.
PADDLEX_MODEL_ROOT=./models
# Change this to a responsive regional Ubuntu mirror if image builds time out.
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
